<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <style>
        :root { --neon: #00f2fe; --bg: #0b0e14; }
        body { background: var(--bg); color: white; font-family: sans-serif; margin: 0; transition: 0.3s; }
        .sidebar { position: fixed; left: -260px; top: 0; width: 250px; height: 100%; background: #151921; transition: 0.4s; z-index: 100; padding: 20px; border-right: 1px solid #333; box-sizing: border-box; }
        .sidebar.active { left: 0; }
        .sidebar a { display: block; color: #888; padding: 15px; text-decoration: none; border-bottom: 1px solid #222; }
        .container { padding: 20px; max-width: 800px; margin: auto; }
        .card { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px; border: 1px solid #333; margin-bottom: 15px; }
        .api-url { background: #000; padding: 10px; border-radius: 5px; color: var(--neon); font-size: 0.8rem; word-break: break-all; margin-top: 10px; border: 1px solid #222; }
        .status-up { color: #2ecc71; } .status-down { color: #ff4757; }
        .menu-btn { font-size: 30px; cursor: pointer; color: var(--neon); }
    </style>
</head>
<body>
    <div class="sidebar" id="side">
        <h3 style="color: var(--neon);">🚀 NX-MONITOR</h3>
        <a href="/dashboard">🏠 Dashboard</a>
        <a href="/admin/master" style="color: #f1c40f;">👑 ADMIN PANEL</a>
        <a href="/logout">🚪 Logout</a>
    </div>

    <div class="container">
        <div style="display:flex; align-items:center; gap:20px;">
            <span class="menu-btn" onclick="document.getElementById('side').classList.toggle('active')">☰</span>
            <h2>Monitor Panel</h2>
        </div>

        <div class="card">
            <strong>GET API URL:</strong>
            <div class="api-url"><%= fullApiUrl %></div>
        </div>

        <form class="card" action="/add-monitor" method="POST">
            <input type="text" name="name" placeholder="Website Name" style="width:100%; padding:10px; margin-bottom:10px; background:#1a202c; border:1px solid #333; color:white;" required>
            <input type="url" name="url" placeholder="https://example.com" style="width:100%; padding:10px; background:#1a202c; border:1px solid #333; color:white;" required>
            <button type="submit" style="width:100%; padding:10px; background:var(--neon); border:none; font-weight:bold; cursor:pointer;">ADD LINK</button>
        </form>

        <% monitors.forEach(m => { %>
            <div class="card">
                <div style="display:flex; justify-content:space-between;">
                    <strong><%= m.name %></strong>
                    <a href="/delete/<%= m._id %>" style="color:#ff4757; text-decoration:none;">Remove</a>
                </div>
                <div style="margin-top:10px; display:flex; justify-content:space-between;">
                    <span class="<%= m.status.includes('UP') ? 'status-up' : 'status-down' %>"><%= m.status %></span>
                    <small style="color:#666;"><%= m.responseTime %></small>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>
